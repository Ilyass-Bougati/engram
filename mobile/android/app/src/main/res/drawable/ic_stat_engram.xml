<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon for study reminders: the mark from frontend/public/favicon.svg in white,
     as Android requires, with the back card as an outline. Same paths as ic_launcher_monochrome.xml,
     centered on the 24dp grid with a little padding. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:translateX="-0.255"
        android:translateY="1.55">
        <group
            android:pivotX="13.75"
            android:pivotY="10.5"
            android:rotation="10">
            <path
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="1.5"
                android:pathData="M10,2.75 H17.5 A2.5,2.5 0 0 1 20,5.25 V15.75 A2.5,2.5 0 0 1 17.5,18.25 H10 A2.5,2.5 0 0 1 7.5,15.75 V5.25 A2.5,2.5 0 0 1 10,2.75 Z" />
        </group>
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M6.5,5.5 H14 A2.5,2.5 0 0 1 16.5,8 V18.5 A2.5,2.5 0 0 1 14,21 H6.5 A2.5,2.5 0 0 1 4,18.5 V8 A2.5,2.5 0 0 1 6.5,5.5 Z" />
    </group>
</vector>
